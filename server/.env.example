PORT=3001
HOST=localhost

# Neon PostgreSQL Database Connection
# 1. Pooled connection string (check "Connection pooling" checkbox in Neon dashboard)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/neondb?sslmode=require"

# 2. Direct connection string (uncheck "Connection pooling" checkbox in Neon dashboard)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/neondb?sslmode=require"